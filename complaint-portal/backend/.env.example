# Copy this file to .env and set your local MySQL credentials.
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Prisma/MySQL connection. Create the database with prisma/create-database.sql first.
DATABASE_URL="mysql://root:your_password@localhost:3306/pothole_db"

# Replace both secrets before using this outside local development.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h
ADMIN_PASSWORD=replace-with-a-strong-admin-password
